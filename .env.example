# Copy to .env and edit. Placeholders only: never commit real secrets.
# Node 20.6+: node --env-file=.env server.js
PORT=3000
SITE_NAME=CampusNet
DATA_DIR=./data
# ACCESS_CODE=change-me-shared-join-code
# ADMIN_USERS=alice            # these names can only be registered with ADMIN_CODE
# ADMIN_CODE=change-me-admin-code
MAX_FILE_MB=100
MAX_STORAGE_MB=2000
MAX_USER_MB=500
SESSION_HOURS=168
SESSION_IDLE_HOURS=24
# HTTPS_PORT=3443              # HTTPS (self-signed via openssl, or TLS_CERT) next to plain HTTP on PORT; `npm start` sets PORT+443 on a personal machine
# HTTPS=1                      # HTTPS only, on PORT (no plain HTTP)
# TLS_CERT=/path/cert.pem
# TLS_KEY=/path/key.pem
# TRUST_PROXY=1                # number of reverse proxies in front (1 = one)
